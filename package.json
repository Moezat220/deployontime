{
  "name": "deployontime",
  "mcpName": "io.github.Moezat220/deployontime",
  "version": "0.3.1",
  "description": "A shared job queue that lets several coding agents use one computer without overloading it.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "keywords": [
    "coding-agents",
    "queue",
    "ai-agents",
    "claude-code",
    "codex",
    "mcp",
    "test-runner",
    "developer-tools"
  ],
  "homepage": "https://deployontime.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moezat220/deployontime.git"
  },
  "bugs": {
    "url": "https://github.com/Moezat220/deployontime/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "dotime-queue": "queue/cli.mjs",
    "dotime-mcp": "mcp/server.mjs"
  },
  "files": [
    "queue/*.mjs",
    "!queue/*.test.mjs",
    "!queue/testkit.mjs",
    "mcp/*.mjs",
    "!mcp/*.test.mjs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test"
  }
}
